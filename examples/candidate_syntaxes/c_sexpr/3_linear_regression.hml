; Candidate C. Problem 3.
(module LinearRegression
  (index N Natural)
  (index P Natural)
  (obs x (Matrix Real N P))
  (obs y (Vector Real N))
  (param beta (Vector Real P))
  (param sigma PositiveReal)
  (require (> sigma 0))
  (likelihood y (given x beta sigma)
    (NormalVector (location (@ x beta)) (scale sigma)))
  (infer posterior beta sigma))
