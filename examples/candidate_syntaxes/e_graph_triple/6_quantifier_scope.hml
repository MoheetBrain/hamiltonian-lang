# Candidate E. Problem 6. The two orders differ by which Quantifier node the
# Definition points at, and by which one owns the other as quantBody.
# That is TWO triples' difference out of the whole file - see E2 in the grammar.
M is Module
M name QuantifierScope
# ---- order 1 : forall x . exists y . y > x   (TRUE) ----
ua is Definition
ua inModule M
ua order 1
ua name unbounded_above
ua hasType _:t_prop1
_:t_prop1 is Type
_:t_prop1 typeCtor Proposition
ua memberBody _:q1out
_:q1out is Quantifier
_:q1out quantKind forall
_:q1out quantVar _:q1x
_:q1x is Declaration
_:q1x name x
_:q1x hasType _:q1xt
_:q1xt is Type
_:q1xt typeCtor Real
_:q1out quantBody _:q1in
_:q1in is Quantifier
_:q1in quantKind exists
_:q1in quantVar _:q1y
_:q1y is Declaration
_:q1y name y
_:q1y hasType _:q1yt
_:q1yt is Type
_:q1yt typeCtor Real
_:q1in quantBody _:q1c
_:q1c is Comparison
_:q1c op >
_:q1c lhs _:q1cl
_:q1cl is Ref
_:q1cl refTo _:q1y
_:q1c rhs _:q1cr
_:q1cr is Ref
_:q1cr refTo _:q1x
# ---- order 2 : exists y . forall x . y > x   (FALSE) ----
gr is Definition
gr inModule M
gr order 2
gr name greatest_real_exists
gr hasType _:t_prop2
_:t_prop2 is Type
_:t_prop2 typeCtor Proposition
gr memberBody _:q2out
_:q2out is Quantifier
_:q2out quantKind exists
_:q2out quantVar _:q2y
_:q2y is Declaration
_:q2y name y
_:q2y hasType _:q2yt
_:q2yt is Type
_:q2yt typeCtor Real
_:q2out quantBody _:q2in
_:q2in is Quantifier
_:q2in quantKind forall
_:q2in quantVar _:q2x
_:q2x is Declaration
_:q2x name x
_:q2x hasType _:q2xt
_:q2xt is Type
_:q2xt typeCtor Real
_:q2in quantBody _:q2c
_:q2c is Comparison
_:q2c op >
_:q2c lhs _:q2cl
_:q2cl is Ref
_:q2cl refTo _:q2y
_:q2c rhs _:q2cr
_:q2cr is Ref
_:q2cr refTo _:q2x
# ---- obligations ----
pf is Proof
pf inModule M
pf order 3
pf asserts _:pfr
_:pfr is Ref
_:pfr refTo ua
ck is Check
ck inModule M
ck order 4
ck checkKind proposition
ck asserts _:neg
_:neg is UnaryOp
_:neg op not
_:neg operand _:negr
_:negr is Ref
_:negr refTo gr
