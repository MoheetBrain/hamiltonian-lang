# Candidate E. Problem 2.
M is Module
M name BayesianCoin
theta is Declaration
theta inModule M
theta order 1
theta declKind param
theta hasType _:t_th
_:t_th is Type
_:t_th typeCtor Probability
trials is Declaration
trials inModule M
trials order 2
trials declKind const
trials hasType _:t_tr
_:t_tr is Type
_:t_tr typeCtor Natural
trials hasValue _:v_tr
_:v_tr is Literal
_:v_tr litValue 10
successes is Declaration
successes inModule M
successes order 3
successes declKind obs
successes hasType _:t_su
_:t_su is Type
_:t_su typeCtor Natural
successes hasValue _:v_su
_:v_su is Literal
_:v_su litValue 7
prior1 is Law
prior1 inModule M
prior1 order 4
prior1 lawRole prior
prior1 lawTarget theta
prior1 lawDist _:dp
_:dp is DistExpr
_:dp distFamily Beta
_:dp distArg _:pa1
_:pa1 is Argument
_:pa1 argRole alpha
_:pa1 argValue _:pv1
_:pv1 is Literal
_:pv1 litValue 1
_:dp distArg _:pa2
_:pa2 is Argument
_:pa2 argRole beta
_:pa2 argValue _:pv2
_:pv2 is Literal
_:pv2 litValue 1
lik1 is Law
lik1 inModule M
lik1 order 5
lik1 lawRole likelihood
lik1 lawTarget successes
lik1 lawGiven theta
lik1 lawDist _:dl
_:dl is DistExpr
_:dl distFamily Binomial
_:dl distArg _:la1
_:la1 is Argument
_:la1 argRole trials
_:la1 argValue _:lv1
_:lv1 is Ref
_:lv1 refTo trials
_:dl distArg _:la2
_:la2 is Argument
_:la2 argRole prob
_:la2 argValue _:lv2
