# Candidate E. Problem 1. subject predicate object, one fact per line.
M is Module
M name NormalDistribution
mu is Declaration
mu inModule M
mu order 1
mu declKind param
mu hasType _:t_mu
_:t_mu is Type
_:t_mu typeCtor Real
sigma is Declaration
sigma inModule M
sigma order 2
sigma declKind param
sigma hasType _:t_sg
_:t_sg is Type
_:t_sg typeCtor PositiveReal
c1 is Constraint
c1 inModule M
c1 order 3
c1 asserts _:c1e
_:c1e is Comparison
_:c1e op >
_:c1e lhs _:c1l
_:c1l is Ref
_:c1l refTo sigma
_:c1e rhs _:c1r
_:c1r is Literal
_:c1r litValue 0
X is Declaration
X inModule M
X order 4
X declKind rv
X hasType _:t_X
_:t_X is Type
_:t_X typeCtor RandomVariable
_:t_X typeSupport _:t_Xs
_:t_Xs is Type
_:t_Xs typeCtor Real
lw is Law
lw inModule M
lw order 5
lw lawRole law
lw lawTarget X
lw lawDist _:d
_:d is DistExpr
_:d distFamily Normal
_:d distArg _:a1
_:a1 is Argument
_:a1 argRole location
_:a1 argValue _:v1
_:v1 is Ref
_:v1 refTo mu
_:d distArg _:a2
_:a2 is Argument
_:a2 argRole scale
_:a2 argValue _:v2
_:v2 is Ref
_:v2 refTo sigma
