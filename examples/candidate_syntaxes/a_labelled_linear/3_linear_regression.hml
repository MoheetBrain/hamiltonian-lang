# Candidate A. Problem 3: Bayesian linear regression.
module LinearRegression

index N : Natural
index P : Natural
obs x : Matrix[Real, N, P]
obs y : Vector[Real, N]
param beta : Vector[Real, P]
param sigma : PositiveReal
require sigma > 0
const beta_prior_mean : Vector[Real, P]
const beta_prior_scale : PositiveReal
const sigma_prior_scale : PositiveReal
prior beta ~ NormalVector(location := beta_prior_mean, scale := beta_prior_scale)
prior sigma ~ HalfNormal(scale := sigma_prior_scale)
likelihood y | x, beta, sigma ~ NormalVector(location := x @ beta, scale := sigma)
infer posterior beta, sigma
