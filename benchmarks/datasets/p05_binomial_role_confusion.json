        "kind": "param",
        "type": "Probability"
      },
      "failures": {
        "kind": "obs",
        "type": "Natural",
        "stochastic": true
      }
    },
    "laws": {
      "failures": {
        "family": "Binomial",
        "roles": {
          "trials": "sample_size",
          "prob": "failure_probability"
        }
